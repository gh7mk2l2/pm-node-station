# PM 节点公益站配置（生产放在 /data/pm-node-station-prod/.env）
# 复制本文件为 .env 后填入真实值；不要把填好的 .env 提交到任何公开位置。

# 服务监听地址（内网）
BIND=127.0.0.1:8882
# 站点对外地址：订阅链接和 OAuth 回调都用它
APP_URL=https://nodes.pmcat.top
# 数据库（新建的 pmnodes 库，不要用 pmplan）
DATABASE_URL=postgres://user:password@localhost:5432/dbname
# 前端静态目录（生产：/data/pm-node-station-prod/web）
WEB_DIR=./web

# ---- LinuxDo OAuth（在 LINUX DO Connect 新建应用或给 PM-Plan 的应用加回调）----
# 回调地址：{APP_URL}/oauth/linuxdo，例如 https://nodes.pmcat.top/oauth/linuxdo（与 LINUX DO Connect 后台注册的一致）
LINUXDO_CLIENT_ID=YOUR_LINUXDO_CLIENT_ID
LINUXDO_CLIENT_SECRET=YOUR_LINUXDO_CLIENT_SECRET
# 以下三个端点一般不用改
LINUXDO_AUTH_ENDPOINT=https://connect.linux.do/oauth2/authorize
LINUXDO_TOKEN_ENDPOINT=https://connect.linux.do/oauth2/token
LINUXDO_USERINFO_ENDPOINT=https://connect.linux.do/api/user

# ---- 可选 ----
# 最低信任等级（默认 1）
TRUST_LEVEL_MIN=1
# 初始管理员 LinuxDo 用户名（逗号分隔；首位注册用户自动为 root）
ADMIN_USERNAMES=
# 上游订阅地址兜底（优先用后台数据库配置，这里只是兜底）
UPSTREAM_SUBSCRIPTION_URL=
# 时区偏移（默认 +08:00）
APP_TIMEZONE_OFFSET=+08:00
# 是否强制 Secure Cookie（默认按 APP_URL 是否 https 自动判断）
# COOKIE_SECURE=true
